{
  "extends": "../tsconfig.json",
  "include": ["**/*.ts"],
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "composite": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "@/*": ["../src/*"]
    },
    "module": "ESNext",
    "moduleResolution": "Bundler"
  }
}
