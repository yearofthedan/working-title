{
  "name": "Working Title Dev Container",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": ["--memory=8g", "--memory-swap=8g", "--shm-size=2gb"],
  "features": {
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest",
      "ppa": true
    },
    "ghcr.io/devcontainers-extra/features/pnpm:2": {
      "version": "10.0.0"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Vue.volar",
        "Codeium.codeium",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ms-playwright.playwright",
        "RooVeterinaryInc.roo-cline"
      ],
      "settings": {
        "roo-cline.autoImportSettingsPath": ".roo/roo-code-settings.json",
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "[vue]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[typescript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "files.watcherExclude": {
          "**/node_modules/**": true,
          "**/.git/objects/**": true,
          "**/.git/subtree-cache/**": true,
          "**/dist/**": true,
          "**/coverage/**": true,
          "**/.pnpm-store/**": true
        },
        "search.exclude": {
          "**/node_modules": true,
          "**/dist": true,
          "**/coverage": true,
          "**/.pnpm-store": true
        }
      }
    }
  },
  "forwardPorts": [5173, 6006, 9323],
  "portsAttributes": {
    "5173": {
      "label": "Vite Dev Server",
      "onAutoForward": "notify"
    },
    "6006": {
      "label": "Storybook",
      "onAutoForward": "notify"
    },
    "9323": {
      "label": "Playwright reporter",
      "onAutoForward": "notify"
    }
  },
  "remoteUser": "node",
  "mounts": [
    "source=${localEnv:HOME}/.gitconfig,target=/home/node/.gitconfig,type=bind,consistency=cached",
    "source=${localWorkspaceFolderBasename}-node-modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
    "source=${localWorkspaceFolderBasename}-extensions,target=/home/node/.vscode-server/extensions,type=volume",
    "source=${localWorkspaceFolderBasename}-global-storage,target=/home/node/.vscode-server/data/User/globalStorage,type=volume"
  ],
  "onCreateCommand": "sudo chown -R node:node /home/node/.vscode-server/extensions /home/node/.vscode-server/data/User/globalStorage ${containerWorkspaceFolder}",
  "postCreateCommand": "./do bootstrap",
  "postStartCommand": "./do launch-chromium-debug",
  "containerEnv": {
    "PLAYWRIGHT_BROWSERS_PATH": "/home/node/.cache/ms-playwright",
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "GIT_CONFIG_COUNT": "1",
    "GIT_CONFIG_KEY_0": "safe.directory",
    "GIT_CONFIG_VALUE_0": "${containerWorkspaceFolder}"
  }
}
