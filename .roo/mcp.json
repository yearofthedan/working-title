{
	"mcpServers": {
		"light-bridge": {
			"command": "light-bridge",
			"args": ["serve", "--workspace", "/workspaces/working-title"],
			"disabled": false,
			"alwaysAllow": [
				"rename",
				"moveFile",
				"moveSymbol",
				"findReferences",
				"getDefinition",
				"searchText",
				"replaceText"
			]
		}
	}
}