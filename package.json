{
  "name": "working-title",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.27.0"
  },
  "scripts": {
    "test": "vitest --run --project=unit",
    "test:ui": "vitest --ui --project=unit --browser.name=chromium",
    "test:a11y": "vitest --run --project=a11y",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui-host=0.0.0.0 --ui-port=8080",
    "build": "vue-tsc -b && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "lint": "eslint --fix",
    "lint:ts": "vue-tsc -b tsconfig.json --noEmit",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@iconify-json/ph": "1.2.2",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/vue3": "10.6.0",
    "@storybook/vue3-vite": "10.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/dagre": "0.7.54",
    "@types/node": "24.13.3",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-vue": "10.10.0",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "unplugin-icons": "23.0.1",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vitest-browser-vue": "2.1.0",
    "vue-component-type-helpers": "3.3.11",
    "vue-tsc": "3.3.11"
  },
  "dependencies": {
    "@iconify/vue": "5.0.1",
    "@tiptap/starter-kit": "3.26.0",
    "@tiptap/vue-3": "3.26.0",
    "@vue-flow/background": "1.3.2",
    "@vue-flow/controls": "1.1.3",
    "@vue-flow/core": "1.48.2",
    "@vue-flow/minimap": "1.5.4",
    "@vueuse/core": "14.3.0",
    "elkjs": "0.11.1",
    "vue": "3.5.35",
    "vue-i18n": "11.4.5",
    "vue-router": "5.1.0"
  }
}
