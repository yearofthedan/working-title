{
  "name": "working-title",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.27.0"
  },
  "scripts": {
    "test": "vitest --run --project=unit",
    "test:ui": "vitest --ui --project=unit --browser.name=chromium",
    "test:a11y": "vitest --run --project=a11y",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui-host=0.0.0.0 --ui-port=8080",
    "build": "vue-tsc -b && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "lint": "eslint --fix",
    "lint:ts": "vue-tsc -b tsconfig.json --noEmit",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/compat": "2.0.2",
    "@eslint/js": "10.0.1",
    "@iconify-json/ph": "1.2.2",
    "@playwright/test": "1.58.1",
    "@storybook/addon-a11y": "10.2.6",
    "@storybook/addon-vitest": "10.2.6",
    "@storybook/vue3": "10.2.6",
    "@storybook/vue3-vite": "10.2.6",
    "@tailwindcss/vite": "4.1.18",
    "@types/dagre": "0.7.53",
    "@types/node": "24.10.10",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@typescript-eslint/eslint-plugin": "8.56.0",
    "@typescript-eslint/parser": "8.56.0",
    "@vitejs/plugin-vue": "6.0.4",
    "@vitest/browser-playwright": "4.0.18",
    "@vitest/coverage-v8": "4.0.18",
    "@vitest/ui": "4.0.18",
    "@vue/tsconfig": "0.8.1",
    "eslint": "10.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-vue": "10.8.0",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "playwright": "1.58.1",
    "prettier": "3.8.1",
    "storybook": "10.2.6",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.0",
    "unplugin-icons": "23.0.1",
    "vite": "7.3.1",
    "vitest": "4.0.18",
    "vitest-browser-vue": "2.0.2",
    "vue-component-type-helpers": "3.2.4",
    "vue-tsc": "3.2.4"
  },
  "dependencies": {
    "@iconify/vue": "5.0.0",
    "@tiptap/starter-kit": "3.14.0",
    "@tiptap/vue-3": "3.14.0",
    "@vue-flow/background": "1.3.2",
    "@vue-flow/controls": "1.1.3",
    "@vue-flow/core": "1.48.1",
    "@vue-flow/minimap": "1.5.4",
    "@vueuse/core": "14.1.0",
    "elkjs": "0.11.0",
    "vue": "3.5.26",
    "vue-i18n": "11.2.8",
    "vue-router": "4.6.4"
  },
  "pnpm": {
    "overrides": {
      "markdown-it": ">=14.1.1",
      "minimatch@<10.2.1": ">=10.2.1"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2025-69873"
      ]
    }
  }
}
