#!/bin/sh
# help: Refuse a file whose name breaks the convention.

set -eu
LC_ALL=C
export LC_ALL

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

part_ok() {
  case "$1" in
  '' | *[!a-z0-9-]* | -* | *- | *--*) return 1 ;;
  esac
}

name_ok() {
  rest=$1
  while :; do
    case "$rest" in
    *.*) part=${rest%%.*} rest=${rest#*.} ;;
    *) part=$rest rest='' ;;
    esac
    part_ok "$part" || return 1
    [ -n "$rest" ] || return 0
  done
}

: >"$work/bad"
printf 0 >"$work/count"
git ls-files | while IFS= read -r file; do
  printf '%s' "$(( $(cat "$work/count") + 1 ))" >"$work/count"
  base=${file##*/}
  case "$base" in
  AGENTS.md | README.md | SKILL.md | RULES.md) continue ;;
  esac
  [ "$file" = .github/pull_request_template.md ] && continue
  [ "$file" = 'patches/@stryker-mutator__vitest-runner@10.0.0.patch' ] && continue
  case "$file" in
  scripts/_*) base=${base#_} ;;
  esac
  case "$base" in
  .*) base=${base#.} ;;
  esac
  name_ok "$base" || echo "$file" >>"$work/bad"
done

if [ -s "$work/bad" ]; then
  cat "$work/bad"
  echo "A file's name is lowercase kebab-case in every dot-separated part, after any leading dot. The exceptions: names a tool looks for (AGENTS.md, README.md, SKILL.md, RULES.md, .github/pull_request_template.md); a leading _ on a file in scripts/, which marks it as not a task; and the patch pnpm-workspace.yaml names." >&2
  exit 1
fi

count=$(cat "$work/count")
[ "$count" -gt 0 ] || {
  echo "no tracked file was read" >&2
  exit 1
}

echo "every name of the $count tracked files follows the convention"
