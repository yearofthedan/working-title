#!/bin/sh
# help: Refuse a file whose name breaks the convention, and a component's *.dom.ts that exports anything but its render<Component> and types, the app's own excepted.

set -eu
LC_ALL=C
export LC_ALL

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

part_ok() {
  case "$1" in
  '' | *[!a-z0-9-]* | -* | *- | *--*) return 1 ;;
  esac
}

name_ok() {
  rest=$1
  while :; do
    case "$rest" in
    *.*) part=${rest%%.*} rest=${rest#*.} ;;
    *) part=$rest rest='' ;;
    esac
    part_ok "$part" || return 1
    [ -n "$rest" ] || return 0
  done
}

: >"$work/bad"
printf 0 >"$work/count"
git ls-files | while IFS= read -r file; do
  printf '%s' "$(( $(cat "$work/count") + 1 ))" >"$work/count"
  base=${file##*/}
  case "$base" in
  AGENTS.md | CONTRIBUTING.md | README.md | SKILL.md | RULES.md) continue ;;
  esac
  [ "$file" = .github/pull_request_template.md ] && continue
  [ "$file" = 'patches/@stryker-mutator__vitest-runner@10.0.0.patch' ] && continue
  case "$file" in
  scripts/_*) base=${base#_} ;;
  esac
  case "$base" in
  .*) base=${base#.} ;;
  esac
  name_ok "$base" || echo "$file" >>"$work/bad"
done

if [ -s "$work/bad" ]; then
  cat "$work/bad"
  echo "A file's name is lowercase kebab-case in every dot-separated part, after any leading dot. The exceptions: names a tool looks for (AGENTS.md, CONTRIBUTING.md, README.md, SKILL.md, RULES.md, .github/pull_request_template.md); a leading _ on a file in scripts/, which marks it as not a task; and the patch pnpm-workspace.yaml names." >&2
  exit 1
fi

count=$(cat "$work/count")
[ "$count" -gt 0 ] || {
  echo "no tracked file was read" >&2
  exit 1
}

echo "every name of the $count tracked files follows the convention"

: >"$work/phrases"
git grep -l --cached 'StepAction' -- '*.ts' | while IFS= read -r file; do
  case "$file" in
  src/test-helpers/* | *.dsl.ts) continue ;;
  esac
  echo "$file" >>"$work/phrases"
done

if [ -s "$work/phrases" ]; then
  cat "$work/phrases"
  echo "A file that names StepAction holds step phrases, so it is a *.dsl.ts; src/test-helpers/ is the runner, which is no language." >&2
  exit 1
fi

echo "every file naming StepAction is a *.dsl.ts, outside src/test-helpers/"

: >"$work/renders"
git ls-files -- 'src/ui/*/*.dom.ts' | while IFS= read -r file; do
  [ "$file" = 'src/ui/app/app.dom.ts' ] && continue
  folder=${file#src/ui/}
  folder=${folder%%/*}
  [ "${file##*/}" = "$folder.dom.ts" ] || continue
  wanted=render$(printf '%s' "$folder" | awk -F- '{ for (i = 1; i <= NF; i++) printf "%s%s", toupper(substr($i, 1, 1)), substr($i, 2) }')
  values=$(git show ":$file" | grep -E '^export ' | grep -v -E '^export (type|interface) ' |
    sed -E 's/^export (default )?(async )?(const|let|var|function|class|enum)?[[:space:]]*([A-Za-z0-9_$]*).*/\4/' | paste -sd ' ' -)
  [ "$values" = "$wanted" ] || echo "$file exports ${values:-nothing}, not $wanted alone" >>"$work/renders"
done

if [ -s "$work/renders" ]; then
  cat "$work/renders"
  echo "A component's <component>.dom.ts exports one value, render followed by the component's name, and types beside it; anything else it needs is its own, and the app's own app.dom.ts is the one exception." >&2
  exit 1
fi

echo "every component's *.dom.ts exports its render alone, the app's excepted"
