set -eu

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/bin"
PATH="$work/bin:$PATH"
export PATH

failures=0
status=0
ok() { printf 'ok   %s\n' "$1"; }
no() {
  printf 'FAIL %s\n' "$1"
  failures=$((failures + 1))
}
finish() {
  printf '\n%d failed\n' "$failures"
  [ "$failures" -eq 0 ]
}

run_do() {
  status=0
  "$root/do" "$@" >"$work/out" 2>"$work/err" || status=$?
}

expect_out() { if grep -q "$1" "$work/out"; then ok "$2"; else no "$2"; fi; }
expect_err() { if grep -q "$1" "$work/err"; then ok "$2"; else no "$2"; fi; }
expect_status() { if [ "$status" -eq "$1" ]; then ok "$2"; else no "$2 (exit $status)"; fi; }

make_copy() {
  copy="$work/copy"
  mkdir -p "$copy/node_modules/.bin"
  cp "$root/do" "$copy/do"
  cp -R "$root/scripts" "$copy/scripts"
  cp "$root/.secretlintrc.json" "$root/.dependency-cruiser.mjs" "$root/package.json" "$root/pnpm-workspace.yaml" "$root/pnpm-lock.yaml" "$copy/"
  if [ -d "$root/patches" ]; then cp -R "$root/patches" "$copy/patches"; fi
  for tool in vp playwright secretlint depcruise; do
    prefix="$tool "
    [ "$tool" = vp ] && prefix=''
    printf '#!/bin/sh\necho "%s$*" >> "$VP_LOG"\n' "$prefix" >"$copy/node_modules/.bin/$tool"
    chmod +x "$copy/node_modules/.bin/$tool"
    if [ "$tool" = vp ]; then
      cat >>"$copy/node_modules/.bin/vp" <<'STUB'
case "$*" in
'preview '*) [ -z "${VP_PREVIEW_STAYS:-}" ] || sleep 30 ;;
esac
exit 0
STUB
    fi
  done
  printf '#!/bin/sh\necho "node $*" >> "$VP_LOG"\nexec "%s" "$@"\n' "$(command -v node)" >"$copy/node_modules/.bin/node"
  chmod +x "$copy/node_modules/.bin/node"
  printf '#!/bin/sh\n' >"$copy/node_modules/.bin/curl"
  cat >>"$copy/node_modules/.bin/curl" <<'STUB'
echo "curl $*" >>"$VP_LOG"
answered=$(grep -c "^curl " "$VP_LOG" 2>/dev/null) || answered=0
[ "$answered" -le "${CURL_FAILS:-0}" ] && exit 7
exit 0
STUB
  chmod +x "$copy/node_modules/.bin/curl"
  printf '#!/bin/sh\n' >"$copy/node_modules/.bin/pnpm"
  cat >>"$copy/node_modules/.bin/pnpm" <<'STUB'
echo "pnpm $*" >>"$VP_LOG"
case "$*" in
'audit --json')
  [ -n "${PNPM_AUDIT_SILENT:-}" ] && exit 0
  if grep -q 'vulnerable-fixture@' pnpm-lock.yaml 2>/dev/null; then cat "$PNPM_AUDIT_JSON"; else printf %s '{"advisories":{}}'; fi
  ;;
'add '*' --lockfile-only')
  if grep -q patchedDependencies pnpm-workspace.yaml 2>/dev/null && [ ! -d patches ]; then
    echo 'ERR_PNPM_PATCH_NOT_FOUND' >&2
    exit 1
  fi
  for file in package.json pnpm-lock.yaml pnpm-workspace.yaml; do echo '# added' >>"$file"; done
  if [ -z "${PNPM_ADD_CLEAN:-}" ]; then echo 'vulnerable-fixture@1.0.0' >>pnpm-lock.yaml; fi
  ;;
'install --frozen-lockfile')
  if [ -n "${PNPM_INSTALL_FAIL_ALWAYS:-}" ] ||
    { [ -n "${PNPM_INSTALL_FAIL:-}" ] && grep -q '^# added' pnpm-lock.yaml; }; then
    echo 'install failed' >>"$VP_LOG"
    exit 1
  fi
  ;;
esac
STUB
  chmod +x "$copy/node_modules/.bin/pnpm"
  (
    cd "$copy" || exit 1
    git init -q -b main .
    git config user.email t@example.com
    git config user.name t
    git add package.json pnpm-workspace.yaml pnpm-lock.yaml
    git commit -qm base
    git update-ref refs/remotes/origin/main HEAD
  )
  VP_LOG="$work/vp-calls"
  export VP_LOG
}
run_copy() {
  status=0
  : >"$VP_LOG"
  "$copy/do" "$@" >"$work/out" 2>"$work/err" || status=$?
}
expect_vp() { if grep -qx "$1" "$VP_LOG"; then ok "$2"; else no "$2"; fi; }
expect_no_vp() { if grep -qx "$1" "$VP_LOG"; then no "$2"; else ok "$2"; fi; }
expect_vp_literal() { if grep -Fqx "$1" "$VP_LOG"; then ok "$2"; else no "$2"; fi; }
