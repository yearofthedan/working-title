#!/bin/sh
# help: Refuse a layer importing another out of turn, and any cycle, in the files given
# (src when none are). The rules are .dependency-cruiser.mjs.

set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if ! command -v depcruise >/dev/null 2>&1; then
  echo "dependency-cruiser is not installed. Run pnpm install, then try again." >&2
  exit 1
fi

if [ "$#" -eq 0 ]; then
  set -- src
fi

# err-long prints each violation with the comment of the rule it broke, which says
# why and links the record. The exit code is the number of errors, as a linter's.
exec depcruise --config "$root/.dependency-cruiser.mjs" --output-type err-long -- "$@"
