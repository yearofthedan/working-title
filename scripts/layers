#!/bin/sh
# help: Refuse a layer importing another out of turn, any cycle, and a scenario file outside its layer, in the files given (src, and e2e when it is there, when none are). The rules are .dependency-cruiser.mjs.

set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if ! command -v depcruise >/dev/null 2>&1; then
  echo "dependency-cruiser is not installed. Run pnpm install, then try again." >&2
  exit 1
fi

if [ "$#" -eq 0 ]; then
  set -- src
  if [ -d e2e ]; then
    set -- src e2e
  fi
fi

exec depcruise --config "$root/.dependency-cruiser.mjs" --output-type err-long -- "$@"
