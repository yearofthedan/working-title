#!/bin/sh
# Run every local check: secrets, format, lint and types, the direction of the
# layers, the dependency audit, the browser specs, then the tests.

set -eu

. "$(dirname "$0")/_vp"

"$(dirname "$0")/../do" secrets
vp check
"$(dirname "$0")/../do" layers
"$(dirname "$0")/../do" audit
# The specs run first because `./do e2e` is what installs Chromium, and the tests'
# browser project needs a browser: on a fresh CI runner, tests first would find none.
"$(dirname "$0")/../do" e2e
"$(dirname "$0")/../do" test
