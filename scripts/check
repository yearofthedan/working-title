#!/bin/sh
# help: Run every local check: secrets, format, lint and types, the direction of the layers, the dependency audit, the link check, the names, docs, comments and test-file checks, the journeys, then the tests.

set -eu

. "$(dirname "$0")/_vp"

"$(dirname "$0")/../do" secrets
vp check
"$(dirname "$0")/../do" layers
"$(dirname "$0")/../do" audit
"$(dirname "$0")/../do" check-links
"$(dirname "$0")/../do" check-names
"$(dirname "$0")/../do" check-docs
"$(dirname "$0")/../do" check-comments
"$(dirname "$0")/../do" check-test-files
"$(dirname "$0")/../do" e2e
"$(dirname "$0")/../do" test
