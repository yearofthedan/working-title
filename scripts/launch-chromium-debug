#!/bin/bash
# Launches chromium in remote debugging mode. Usage: ./do launch-chromium-debug
# Useful for Roo Code browser automation in a container.

# 1. Find the chromium binary installed by playwright
CHROME_BIN=$(find "$PLAYWRIGHT_BROWSERS_PATH" -name chrome | grep chromium | head -n 1)

if [ -z "$CHROME_BIN" ]; then
    echo "Error: Chromium not found in $PLAYWRIGHT_BROWSERS_PATH."
    echo "Ensure './do bootstrap' has run successfully."
    exit 1
fi

if ! curl -s http://localhost:9222/json/version > /dev/null 2>&1; then
    echo "Starting Chromium from: $CHROME_BIN"
    
    nohup "$CHROME_BIN" \
      --remote-debugging-port=9222 \
      --headless=new \
      --no-sandbox \
      --disable-dev-shm-usage > /tmp/chrome-debug.log 2>&1 &
    
    sleep 2
else
    echo "Chromium is already running on port 9222."
fi
