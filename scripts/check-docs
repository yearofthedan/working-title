#!/bin/sh
# Refuse a docs page that does not open with its audience and purpose.
#
# The rule: a page under docs/ states **Audience:** and **Purpose:** before its
# first "## " heading, so a reader learns who it is for and what it covers
# without reading on. The opening ends at the first "## " heading and not at a
# deeper one, since a subheading still belongs to what the page opens with. The
# exception: a numbered record docs/adr/NNNN-*.md, whose shape is the
# writing-adrs skill's and not this one's.

set -eu

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

# The exception is a numbered record sitting directly in docs/adr, four digits
# and a hyphen. Read from the path's two ends, since a case pattern's * crosses a
# slash: a page below such a record is not the record.
record_ok() {
  [ "${1%/*}" = docs/adr ] || return 1
  case "${1##*/}" in
  [0-9][0-9][0-9][0-9]-*.md) return 0 ;;
  esac
  return 1
}

# The opening is the lines before the first "## " heading, inclusive of nothing
# below it; a page with no such heading opens with the whole file.
opening_ok() {
  opening=$(sed -n '1,/^## /p' "$1")
  printf '%s\n' "$opening" | grep -q '^\*\*Audience:\*\*' || return 1
  printf '%s\n' "$opening" | grep -q '^\*\*Purpose:\*\*' || return 1
}

: >"$work/bad"
printf 0 >"$work/count"
# Only what git tracks is read, as the rest of the checks read the tree git is
# in, and only a markdown file under docs/ is a page. The pathspec's * does cross
# a slash, so this is the whole of docs/ at any depth.
git ls-files 'docs/*.md' | while IFS= read -r file; do
  record_ok "$file" && continue
  printf '%s' "$(( $(cat "$work/count") + 1 ))" >"$work/count"
  opening_ok "$file" || echo "$file" >>"$work/bad"
done

if [ -s "$work/bad" ]; then
  cat "$work/bad"
  echo "A page under docs/ states **Audience:** and **Purpose:** before its first ## heading. The exception: a numbered record docs/adr/NNNN-*.md, which opens the way the writing-adrs skill says instead." >&2
  exit 1
fi

# A run that read nothing is not a pass: no repository, or nothing tracked.
count=$(cat "$work/count")
[ "$count" -gt 0 ] || {
  echo "no docs page was read" >&2
  exit 1
}

echo "every one of the $count docs pages opens with its audience and purpose"
