#!/bin/sh
# Approve what a test run produced: vp test --update=all, which writes the snapshots a run refuses to write.

set -eu

. "$(dirname "$0")/_vp"

if [ "$#" -eq 0 ] || [ ! -f "$1" ]; then
  echo "Name the test file to approve first: ./do approve <test file> [-t <test name>]" >&2
  exit 2
fi

exec vp test --update=all "$@"
