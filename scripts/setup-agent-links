#!/bin/bash
# Sets up symbolic links for Roo to access agent rules.

. "$(dirname "$0")"/_common
PROJECT_ROOT=$(dirname "$0")/..

echo -e "${INFO_COLOR}Setting up AI agent rule links...${RESET_COLOR}"

# Function to safely create symlinks without recursion
# Usage: safe_link <target_path> <link_name>
safe_link() {
  local target="$1"
  local link="$PROJECT_ROOT/$2"
  
  # Remove if it exists (handles both files, symlinks, and directories)
  rm -rf "$link"
  
  # Ensure parent directory exists
  mkdir -p "$(dirname "$link")"
  
  # Create symlink
  ln -s "$target" "$link"
}

# Link common rules (all modes)
echo -e "${INFO_COLOR}Linking .agents/rules to .roo/rules...${RESET_COLOR}"
safe_link "../.agents/rules" ".roo/rules"

# Link code-specific rules (Code/Debug modes)
# Note: Code and Debug modes share the same technical implementation rules
echo -e "${INFO_COLOR}Linking .agents/rules-code to .roo/rules-code (Code mode)...${RESET_COLOR}"
safe_link "../.agents/rules-code" ".roo/rules-code"

echo -e "${INFO_COLOR}Linking .agents/rules-code to .roo/rules-debug (Debug mode)...${RESET_COLOR}"
safe_link "../.agents/rules-code" ".roo/rules-debug"

echo -e "${SUCCESS_COLOR}Agent links configured successfully.${RESET_COLOR}"
