#!/bin/sh
# help: Run the tests.

set -eu

. "$(dirname "$0")/_vp"

for arg in "$@"; do
  case "$arg" in
  -u | --update | --update=*)
    echo "Tests never write an approved scenario. Approving is explicit and intentional, with ./do approve <scenario file>. Verify the intent of the update before continuing." >&2
    exit 2
    ;;
  esac
done

vp test "$@"
