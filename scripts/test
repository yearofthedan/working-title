#!/bin/sh
# Run the tests.

set -eu

. "$(dirname "$0")/_vp"

for arg in "$@"; do
  case "$arg" in
  -u | --update | --update=*)
    echo "Tests never write approved files. Scenarios are updated explicitly and intentionally, with ./do approve <test file>. Verify the intent of the update before continuing." >&2
    exit 2
    ;;
  esac
done

vp test "$@"
