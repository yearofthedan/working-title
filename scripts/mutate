#!/bin/sh
# help: Report the mutants the node tests leave in src/domain, src/application and src/ui.

set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if ! command -v stryker >/dev/null 2>&1; then
  echo "stryker is not installed. Run pnpm install, then try again." >&2
  exit 1
fi

exec stryker run "$root/stryker.config.mjs" "$@"
