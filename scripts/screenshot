#!/bin/sh
# help: Screenshot the built app at the widths the look criteria name, each with a piece in focus.

set -eu

. "$(dirname "$0")/_vp"

root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
out="$root/screenshots"
sentences="$root/scripts/_screenshot-long-sentences.json"
scenes="$root/scripts/_screenshot-eight-scenes.json"

if curl -fsS http://localhost:4174 >/dev/null 2>&1; then
  echo "something is already answering on 4174, and the shots would show its build; stop it first" >&2
  exit 1
fi

rm -rf "$out"
mkdir -p "$out"

vp build

vp preview --port 4174 --strictPort &
server=$!
stop() {
  pkill -P "$server" 2>/dev/null || true
  kill "$server" 2>/dev/null || true
  wait "$server" 2>/dev/null || true
}
trap stop EXIT
trap 'echo "the screenshot run was interrupted" >&2; exit 1' INT TERM

tries=0
until curl -fsS http://localhost:4174 >/dev/null 2>&1; do
  if ! kill -0 "$server" 2>/dev/null; then
    echo "the preview on 4174 stopped before it answered" >&2
    exit 1
  fi
  tries=$((tries + 1))
  if [ "$tries" -ge 30 ]; then
    echo "the preview on 4174 did not answer" >&2
    exit 1
  fi
  sleep 1
done

playwright install --with-deps chromium

shot() {
  width=$1
  name=$2
  shift 2
  node "$root/scripts/_screenshot.mjs" "$width" "$out/$name.png" "$@"
}

shot 1440 story-1440 --load-storage "$sentences"
shot 1100 story-1100 --load-storage "$sentences"
shot 1440 beat-2-1440 --load-storage "$sentences" --click 'Beat 2'
shot 1100 beat-2-1100 --load-storage "$sentences" --click 'Beat 2'
shot 1440 eight-scenes-1440 --load-storage "$scenes" --click 'Beat 4'
shot 1100 eight-scenes-1100 --load-storage "$scenes" --click 'Beat 4'
shot 1440 scene-1440 --load-storage "$sentences" --click 'Beat 2' --click 'Scene 1'
shot 1100 scene-1100 --load-storage "$sentences" --click 'Beat 2' --click 'Scene 1'
