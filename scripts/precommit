#!/bin/sh
# help: Check and fix the staged files, then run the checks the staged change needs.

set -eu

. "$(dirname "$0")/_vp"

do="$(dirname "$0")/../do"

"$do" secrets --staged

vp staged "$@"

# shortcut: the checks read the working tree, so unstaged changes count; check the index alone when a partial commit needs it.
staged=$(git diff --cached --name-only --no-renames)
not_markdown=$(printf '%s\n' "$staged" | grep -vE '\.md$' || true)
in_scenarios=$(printf '%s\n' "$staged" | grep -E '^(src|e2e)/' || true)

unset $(git rev-parse --local-env-vars)

if [ -n "$staged" ] && [ -z "$not_markdown" ] && [ -z "$in_scenarios" ]; then
  "$do" check-docs
  "$do" check-links
  "$do" check-names
else
  "$do" check
fi
