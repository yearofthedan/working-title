#!/bin/sh
# Check and fix the staged files, as the pre-commit hook does.

set -eu

. "$(dirname "$0")/_vp"

# The scan reads the staged content, which `vp staged` may rewrite, so it runs first.
if [ -n "$(git diff --cached --name-only --diff-filter=ACM)" ]; then
  git diff --cached --name-only --diff-filter=ACM -z |
    xargs -0 -- "$(dirname "$0")/secrets" --no-glob
fi

vp staged "$@"
