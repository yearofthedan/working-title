#!/bin/sh
# help: Install weaver's skills into .agents/skills. The harness, OMP's plugins, is set up from snippets: see CONTRIBUTING.

set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if ! command -v weaver >/dev/null 2>&1; then
  echo "weaver is not installed. Run pnpm install, then ./do setup again." >&2
  exit 1
fi
weaver skills install --dir "$root/.agents/skills" --force
