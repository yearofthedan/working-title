#!/bin/sh
# Refuse a credential in the files given, across the project when none are, or in
# each staged file's staged copy with --staged.

set -eu

. "$(dirname "$0")/_vp"

if ! command -v secretlint >/dev/null 2>&1; then
  echo "secretlint is not installed. Run pnpm install, then try again." >&2
  exit 1
fi

# A commit holds the staged copy, which the working tree may have diverged from.
# xargs reports a failing command as 123 on Linux; the caller gets 1 anywhere.
if [ "${1:-}" = '--staged' ]; then
  git diff --cached --name-only --diff-filter=d -z |
    xargs -0 sh -c 'for file in "$@"; do git show ":$file" | secretlint --stdinFileName "$file" || exit 1; done' sh ||
    exit 1
  exit 0
fi

if [ "$#" -eq 0 ]; then
  set -- '**/*'
fi

exec secretlint "$@"
