#!/bin/sh
# help: Refuse a credential in the files given, across the project when none are, or in each staged file's staged copy with --staged.

set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if ! command -v secretlint >/dev/null 2>&1; then
  echo "secretlint is not installed. Run pnpm install, then try again." >&2
  exit 1
fi

if [ "${1:-}" = '--staged' ]; then
  [ -n "$(git diff --cached --name-only --diff-filter=d)" ] || exit 0

  staged=$(mktemp -d)
  trap 'rm -rf "$staged"' EXIT

  cp "$root/.secretlintrc.json" "$staged/"
  if [ -f "$root/.secretlintignore" ]; then
    cp "$root/.secretlintignore" "$staged/"
  fi

  git diff --cached --name-only --diff-filter=d -z |
    git checkout-index --prefix="$staged/" -z --stdin
  cd "$staged"
  secretlint '**/*'
  exit 0
fi

if [ "$#" -eq 0 ]; then
  set -- '**/*'
fi

exec secretlint "$@"
