#!/bin/sh
# Refuse a credential in the files given, across the project when none are, or in
# each staged file's staged copy with --staged.

set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if ! command -v secretlint >/dev/null 2>&1; then
  echo "secretlint is not installed. Run pnpm install, then try again." >&2
  exit 1
fi

# The commit holds the staged copy, which the working tree may have diverged from,
# so the staged copies are laid out in a tree of their own and scanned in one pass.
# One pass reports every hit; a pass per file would stop at the first. A commit
# with nothing to scan, such as one that only deletes files or changes a message,
# has no staged file to lay out and nothing to refuse.
if [ "${1:-}" = '--staged' ]; then
  [ -n "$(git diff --cached --name-only --diff-filter=d)" ] || exit 0

  staged=$(mktemp -d)
  trap 'rm -rf "$staged"' EXIT

  # The scanner reads its config and its ignore list from the tree it walks.
  cp "$root/.secretlintrc.json" "$staged/"
  if [ -f "$root/.secretlintignore" ]; then
    cp "$root/.secretlintignore" "$staged/"
  fi

  git diff --cached --name-only --diff-filter=d -z |
    git checkout-index --prefix="$staged/" -z --stdin
  cd "$staged"
  secretlint '**/*'
  exit 0
fi

if [ "$#" -eq 0 ]; then
  set -- '**/*'
fi

exec secretlint "$@"
